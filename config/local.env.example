# Copy to config/local.env; this file is sourced by Bash.
# SSH authentication belongs in your normal SSH agent/configuration.
HB_ROBOT_HOST=robot.local
HB_WORKSTATION_HOST=workstation.local
HB_WORKSTATION_USER=robotics
HB_WORKSTATION_HOST_KEY_ALIAS=workstation.local
HB_ROSBRIDGE_SOURCE=ws://127.0.0.1:19090

# Optional OpenAI-compatible provider. Keep the key outside the repository.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY_FILE="$HOME/.config/homebody/openai.key"
HB_MODEL=astra-api

# Existing authenticated G1 teleoperation service, forwarded to this host.
HB_TELEOP_TOKEN_FILE="$HOME/.config/homebody/g1-teleop.token"
